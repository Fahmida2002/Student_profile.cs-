@model List<Student_Profile.Models.Student_profile>

@{
    ViewData["Title"] = "Student List";
}

<h2 class="text-center">Student Profile List</h2>

<table border="1" cellpadding="10" cellspacing="0"
       style="margin:auto; width:60%; text-align:center;">

    <tr style="background-color:#f2f2f2;">
        <th>ID</th>
        <th>Name</th>
        <th>Department</th>
        <th>CGPA</th>
    </tr>

    @if (Model != null && Model.Count > 0)
    {
        foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Department</td>
                <td>@student.CGPA</td>
            </tr>
        }
    }
    else
    {
        <tr>
            <td colspan="4" style="color:red;">No Data Found</td>
        </tr>
    }

</table>
